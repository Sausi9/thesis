#!/usr/bin/env bash
#BSUB -q gpul40s
#BSUB -J cifar_tds_sweep
#BSUB -n 4
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32GB]"
#BSUB -M 32GB
#BSUB -W 24:00
#BSUB -o jobs/logs/brightness_tds_sweep_%J.out
#BSUB -e jobs/logs/brightness_tds_sweep_%J.err
#BSUB -u s242762@dtu.dk
#BSUB -B
#BSUB -N

set -euo pipefail

cd "$LS_SUBCWD"
mkdir -p jobs/logs

NUM_SAMPLES_PER_SETTING="${NUM_SAMPLES_PER_SETTING:-250}"
NUM_PARTICLES="${NUM_PARTICLES:-32}"
BATCH_SIZE="${BATCH_SIZE:-32}"
NUM_STEPS="${NUM_STEPS:-1000}"
TARGET_MEAN="${TARGET_MEAN:-0.8}"
TARGET_VARIANCE="${TARGET_VARIANCE:-0.01}"
OUTPUT_NAME="${OUTPUT_NAME:-null}"
ARTIFACT_PATH="${ARTIFACT_PATH:-null}"
SOURCE_SAMPLE_PATH="${SOURCE_SAMPLE_PATH:-null}"
EXTRA_OVERRIDES="${EXTRA_OVERRIDES:-}"

bash jobs/brightness_tds_sweep.sh \
  device=cuda \
  sweep.num_samples_per_setting="$NUM_SAMPLES_PER_SETTING" \
  sampler.num_particles="$NUM_PARTICLES" \
  sampling.batch_size="$BATCH_SIZE" \
  sampling.num_steps="$NUM_STEPS" \
  sweep.target_mean="$TARGET_MEAN" \
  sweep.target_variance="$TARGET_VARIANCE" \
  sweep.output_name="$OUTPUT_NAME" \
  sampling.artifact_path="$ARTIFACT_PATH" \
  jeffrey.source_sample_path="$SOURCE_SAMPLE_PATH" \
  sampling.progress=true \
  $EXTRA_OVERRIDES
