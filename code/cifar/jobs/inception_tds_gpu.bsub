#!/usr/bin/env bash
#BSUB -q gpul40s
#BSUB -J cifar_inc_tds
#BSUB -n 4
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=32GB]"
#BSUB -M 32GB
#BSUB -W 24:00
#BSUB -o jobs/logs/inception_tds_%J.out
#BSUB -e jobs/logs/inception_tds_%J.err
#BSUB -u s242762@dtu.dk
#BSUB -B
#BSUB -N

set -euo pipefail

cd "$LS_SUBCWD"
mkdir -p jobs/logs

NUM_SAMPLES="${NUM_SAMPLES:-8}"
BATCH_SIZE="${BATCH_SIZE:-1}"
NUM_PARTICLES="${NUM_PARTICLES:-4}"
NUM_STEPS="${NUM_STEPS:-1000}"
GUIDANCE_SCALE="${GUIDANCE_SCALE:-1.0}"
OUTPUT_NAME="${OUTPUT_NAME:-null}"
ARTIFACT_PATH="${ARTIFACT_PATH:-null}"
RATIO_CLASSIFIER_PATH="${RATIO_CLASSIFIER_PATH:-artifacts/ratio_classifiers/best_model_inception_ratio/classifier.pt}"
EXTRA_OVERRIDES="${EXTRA_OVERRIDES:-}"

bash jobs/inception_tds.sh \
  device=cuda \
  jeffrey=inception_ratio \
  sampling.num_samples="$NUM_SAMPLES" \
  sampling.batch_size="$BATCH_SIZE" \
  sampler.num_particles="$NUM_PARTICLES" \
  sampling.num_steps="$NUM_STEPS" \
  sampling.output_name="$OUTPUT_NAME" \
  sampling.artifact_path="$ARTIFACT_PATH" \
  jeffrey.ratio_classifier_path="$RATIO_CLASSIFIER_PATH" \
  jeffrey.guidance_scale="$GUIDANCE_SCALE" \
  sampler.guidance_start=0.5 \
  sampling.progress=true \
  $EXTRA_OVERRIDES
