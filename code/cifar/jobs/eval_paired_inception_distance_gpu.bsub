set -euo pipefail

cd "$LS_SUBCWD"
mkdir -p jobs/logs

SAMPLE_PATH="${SAMPLE_PATH:-null}"
TOP_K="${TOP_K:-4}"
EXTRA_OVERRIDES="${EXTRA_OVERRIDES:-}"

bash jobs/eval_paired_inception_distance.sh \
  device=cuda \
  sampling.sample_path="$SAMPLE_PATH" \
  paired.top_k="$TOP_K" \
  $EXTRA_OVERRIDES
