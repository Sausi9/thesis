set -euo pipefail

cd "$LS_SUBCWD"
mkdir -p jobs/logs

SAMPLE_PATH="${SAMPLE_PATH:-null}"
EXTRA_OVERRIDES="${EXTRA_OVERRIDES:-}"

bash jobs/eval.sh \
  sampling.sample_path="$SAMPLE_PATH" \
  eval.fid.enabled=true \
  eval.fid.cuda=true \
  $EXTRA_OVERRIDES
