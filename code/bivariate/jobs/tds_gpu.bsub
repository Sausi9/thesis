#!/usr/bin/env bash
#BSUB -q gpuv100
#BSUB -J bivariate_tds
#BSUB -n 4
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16GB]"
#BSUB -M 20GB
#BSUB -W 04:00
#BSUB -o jobs/logs/tds_%J.out
#BSUB -e jobs/logs/tds_%J.err
#BSUB -u s242762@dtu.dk
#BSUB -B
#BSUB -N

set -euo pipefail

cd "$LS_SUBCWD"
mkdir -p jobs/logs

NUM_SAMPLES="${NUM_SAMPLES:-512}"
NUM_PARTICLES="${NUM_PARTICLES:-32}"
NUM_STEPS="${NUM_STEPS:-1000}"
OUTPUT_NAME="${OUTPUT_NAME:-null}"
ARTIFACT_PATH="${ARTIFACT_PATH:-null}"
EXTRA_OVERRIDES="${EXTRA_OVERRIDES:-}"
SAMPLES_DIR="${SAMPLES_DIR:-}"
JEFFREY_MEAN="${JEFFREY_MEAN:-}"
JEFFREY_VARIANCE="${JEFFREY_VARIANCE:-}"

HYDRA_OVERRIDES=(
  device=cuda
  sampling.num_samples="$NUM_SAMPLES"
  sampler.num_particles="$NUM_PARTICLES"
  sampling.num_steps="$NUM_STEPS"
  sampling.output_name="$OUTPUT_NAME"
  sampling.artifact_path="$ARTIFACT_PATH"
  sampling.progress=true
)

if [[ -n "$SAMPLES_DIR" ]]; then
  HYDRA_OVERRIDES+=(sampling.output_dir="$SAMPLES_DIR")
fi
if [[ -n "$JEFFREY_MEAN" ]]; then
  HYDRA_OVERRIDES+=(jeffrey.target.mean="$JEFFREY_MEAN")
fi
if [[ -n "$JEFFREY_VARIANCE" ]]; then
  HYDRA_OVERRIDES+=(jeffrey.target.variance="$JEFFREY_VARIANCE")
fi

echo "NUM_SAMPLES=$NUM_SAMPLES"
echo "NUM_PARTICLES=$NUM_PARTICLES"
echo "NUM_STEPS=$NUM_STEPS"
echo "OUTPUT_NAME=$OUTPUT_NAME"
echo "ARTIFACT_PATH=$ARTIFACT_PATH"
echo "SAMPLES_DIR=$SAMPLES_DIR"
echo "JEFFREY_MEAN=$JEFFREY_MEAN"
echo "JEFFREY_VARIANCE=$JEFFREY_VARIANCE"
echo "EXTRA_OVERRIDES=$EXTRA_OVERRIDES"

bash jobs/tds.sh "${HYDRA_OVERRIDES[@]}" $EXTRA_OVERRIDES
