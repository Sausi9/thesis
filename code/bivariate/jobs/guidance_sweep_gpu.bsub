#!/usr/bin/env bash
#BSUB -q gpua100
#BSUB -J bivariate_guidance_sweep
#BSUB -n 4
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -R "span[hosts=1]"
#BSUB -R "rusage[mem=16GB]"
#BSUB -M 16GB
#BSUB -W 24:00
#BSUB -o jobs/logs/guidance_sweep_%J.out
#BSUB -e jobs/logs/guidance_sweep_%J.err
#BSUB -u s242762@dtu.dk
#BSUB -B
#BSUB -N

set -euo pipefail

cd "$LS_SUBCWD"
mkdir -p jobs/logs

STAGE="${STAGE:-calibration}"
OUTPUT_NAME="${OUTPUT_NAME:-null}"
RESUME="${RESUME:-false}"
CALIBRATION_RESULTS_PATH="${CALIBRATION_RESULTS_PATH:-null}"
ARTIFACT_PATH="${ARTIFACT_PATH:?Set ARTIFACT_PATH to the exact model artifact}"
SOURCE_SAMPLE_PATH="${SOURCE_SAMPLE_PATH:?Set SOURCE_SAMPLE_PATH to matching model samples}"
NUM_STEPS="${NUM_STEPS:-1000}"
BATCH_SIZE="${BATCH_SIZE:-500}"
CALIBRATION_NUM_SAMPLES="${CALIBRATION_NUM_SAMPLES:-1000}"
CALIBRATION_NUM_PARTICLES="${CALIBRATION_NUM_PARTICLES:-256}"
CONFIRMATION_NUM_SAMPLES="${CONFIRMATION_NUM_SAMPLES:-12000}"
CONFIRMATION_NUM_PARTICLES="${CONFIRMATION_NUM_PARTICLES:-2048}"
EXTRA_OVERRIDES="${EXTRA_OVERRIDES:-}"

bash jobs/guidance_sweep.sh \
  device=cuda \
  sweep.stage="$STAGE" \
  sweep.output_name="$OUTPUT_NAME" \
  sweep.resume="$RESUME" \
  sweep.calibration_results_path="$CALIBRATION_RESULTS_PATH" \
  sweep.num_steps="$NUM_STEPS" \
  sweep.batch_size="$BATCH_SIZE" \
  sweep.calibration.num_samples_per_setting="$CALIBRATION_NUM_SAMPLES" \
  sweep.calibration.num_particles="$CALIBRATION_NUM_PARTICLES" \
  sweep.confirmation.num_samples_per_setting="$CONFIRMATION_NUM_SAMPLES" \
  sweep.confirmation.num_particles="$CONFIRMATION_NUM_PARTICLES" \
  sampling.artifact_path="$ARTIFACT_PATH" \
  jeffrey.source_sample_path="$SOURCE_SAMPLE_PATH" \
  sampling.progress=true \
  $EXTRA_OVERRIDES
